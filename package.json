{
  "name": "kimai-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server for Kimai time tracking (REST API)",
  "bin": {
    "kimai-mcp": "./dist/index.js",
    "kimai-mcp-http": "./dist/http-server.js"
  },
  "scripts": {
    "build": "tsc",
    "build:api-docs": "node scripts/build-mcp-tools-api-docs.mjs",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "dev": "node --import tsx src/index.ts",
    "dev:http": "node --import tsx src/http-server.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "swagger2openapi": "^7.0.8",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
