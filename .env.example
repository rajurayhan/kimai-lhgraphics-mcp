# Kimai instance (required)
KIMAI_BASE_URL=https://your-kimai.example.com

# Local stdio mode: credentials for the MCP process
KIMAI_USERNAME=your_api_user
KIMAI_API_TOKEN=your_api_token

# HTTP team server (npm run start:http)
MCP_HOST=0.0.0.0
MCP_PORT=3000
MCP_PATH=/mcp
MCP_SHARED_SECRET=generate-a-long-random-secret
# Comma-separated hostnames allowed in Host header (recommended behind a domain)
# MCP_ALLOWED_HOSTS=mcp.example.com,localhost
